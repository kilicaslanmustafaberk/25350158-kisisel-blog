# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-test/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite*
/.local-backups/
/.claude/

# temp / cache / QA artifacts
/temp/
/tmp/
.tmp*
/cache/
.cache/
.eslintcache
*.har
*cookies*.txt
# root-level PDFs (real CV exports, test PDF output); deliverables/ is decided separately
/*.pdf

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local AI/dev-tool instruction files (not part of the public repo)
/AGENTS.md
/CLAUDE.md

# screenshots showing personal data from the real professional CV
/docs/screenshots/11-professional-cv-pdf.png
/docs/screenshots/11-professional-cv-pdf-fit.png

# Academic binary deliverables
/deliverables/*.docx
/deliverables/*.pdf
/deliverables/*.pptx
/deliverables/*.zip

# Academic delivery package - keep local only
/deliverables/
