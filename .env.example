# Gerçek değerleri commit etmeyin. Secret'larda NEXT_PUBLIC_ prefix'i kullanmayın.

# Turso / libSQL
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Better Auth — secret en az 32 karakterlik yüksek entropili bir değer olmalıdır.
BETTER_AUTH_SECRET=
# Local: http://localhost:3000 — production: gerçek HTTPS origin (path/query yok).
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 — OPSİYONEL. Boş bırakılırsa local'de medya yükleme kapalı kalır
# (admin "yapılandırılmadı" mesajı gösterir); geri kalan uygulama çalışır.
# Credential değerlerine NEXT_PUBLIC_ prefix'i vermeyin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Production'da custom domain önerilir; r2.dev yalnız development içindir.
# Origin/path `next/image` ve CSP allowlist'ine build sırasında eklenir.
R2_PUBLIC_BASE_URL=

# GitHub public profile (Phase 7) — ikisi de opsiyonel ve yalnız server-side okunur.
# Kullanıcı adı önce görünür social_links içindeki https://github.com/<kullanıcı> kaydından
# türetilir; yoksa bu değer kullanılır. İkisi de yoksa GitHub bölümü render edilmez.
GITHUB_USERNAME=
# Opsiyonel token yalnız rate limit'i yükseltir (60 → 5000 istek/saat). Repository/yazma
# yetkisi gerekmez; NEXT_PUBLIC_ prefix'i asla kullanmayın.
GITHUB_TOKEN=
